NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://splitpot:splitpot@localhost:5433/splitpot?schema=public"
# Em produção (Neon + serverless), DATABASE_URL deve ser a connection string POOLED
# (hostname com -pooler, query string com sslmode=require&pgbouncer=true&connect_timeout=15).
# DATABASE_URL_UNPOOLED é a connection string DIRETA (sem -pooler), usada por
# `prisma migrate` / `prisma db push` — DDL não funciona via PgBouncer.
# Em dev local com Postgres no Docker, basta apontar as duas para a mesma URL.
DATABASE_URL_UNPOOLED="postgresql://splitpot:splitpot@localhost:5433/splitpot?schema=public"

# Firebase Admin (server-side ID token verification)
# Obtenha em Firebase Console > Project Settings > Service Accounts > Generate new private key
# O valor de FIREBASE_PRIVATE_KEY deve preservar os \n como \\n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
