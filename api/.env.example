NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://splitpot:splitpot@localhost:5433/splitpot?schema=public"

# Firebase Admin (server-side ID token verification)
# Obtenha em Firebase Console > Project Settings > Service Accounts > Generate new private key
# O valor de FIREBASE_PRIVATE_KEY deve preservar os \n como \\n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
