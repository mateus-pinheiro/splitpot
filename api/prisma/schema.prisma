generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TableStatus {
  OPEN
  CLOSED
}

enum SettlementStatus {
  PENDING
  CONFIRMED
}

model User {
  id           String   @id @default(cuid())
  firebaseUid  String   @unique
  email        String   @unique
  name         String
  pixKey       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedTables         Table[]              @relation("TableOwner")
  participations      TableParticipation[]
  sentSettlements     Settlement[]         @relation("SettlementFromUser")
  receivedSettlements Settlement[]         @relation("SettlementToUser")

  @@map("users")
}

model Table {
  id        String      @id @default(cuid())
  ownerId   String
  name      String
  minBuyIn  Decimal     @db.Decimal(12, 2)
  status    TableStatus @default(OPEN)
  createdAt DateTime    @default(now())
  closedAt  DateTime?

  owner          User                 @relation("TableOwner", fields: [ownerId], references: [id])
  participations TableParticipation[]
  settlements    Settlement[]

  @@index([ownerId])
  @@index([status])
  @@map("tables")
}

model TableParticipation {
  id       String    @id @default(cuid())
  tableId  String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  table   Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  buyIns  BuyIn[]
  cashOut CashOut?

  @@unique([tableId, userId])
  @@index([userId])
  @@map("table_participations")
}

model BuyIn {
  id              String   @id @default(cuid())
  participationId String
  amount          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  participation TableParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([participationId])
  @@map("buy_ins")
}

model CashOut {
  id              String   @id @default(cuid())
  participationId String   @unique
  amount          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  participation TableParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@map("cash_outs")
}

model Settlement {
  id            String           @id @default(cuid())
  tableId       String
  fromUserId    String
  toUserId      String
  amount        Decimal          @db.Decimal(12, 2)
  pixCopiaECola String?
  status        SettlementStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  confirmedAt   DateTime?

  table    Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFromUser", fields: [fromUserId], references: [id])
  toUser   User  @relation("SettlementToUser", fields: [toUserId], references: [id])

  @@index([tableId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("settlements")
}
