generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TableStatus {
  OPEN
  CLOSED
}

enum SettlementStatus {
  PENDING
  CONFIRMED
}

enum ActionType {
  BUYIN
  REBUY
  LEAVE
  REJOIN
}

enum ActionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  firebaseUid  String   @unique
  email        String   @unique
  name         String
  pixKey       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedTables         Table[]              @relation("TableOwner")
  participations      TableParticipation[]
  sentSettlements     Settlement[]         @relation("SettlementFromUser")
  receivedSettlements Settlement[]         @relation("SettlementToUser")
  actionRequests      ActionRequest[]      @relation("ActionRequestRequester")

  @@map("users")
}

model Table {
  id        String      @id @default(cuid())
  ownerId   String
  name      String
  minBuyIn  Decimal     @db.Decimal(12, 2)
  status    TableStatus @default(OPEN)
  createdAt DateTime    @default(now())
  closedAt  DateTime?

  owner          User                 @relation("TableOwner", fields: [ownerId], references: [id])
  participations TableParticipation[]
  settlements    Settlement[]
  actionRequests ActionRequest[]

  @@index([ownerId])
  @@index([status])
  @@map("tables")
}

model TableParticipation {
  id          String    @id @default(cuid())
  tableId     String
  userId      String?
  guestName   String?
  guestPixKey String?
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  table          Table          @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id])
  buyIns         BuyIn[]
  cashOut        CashOut?
  actionRequests ActionRequest[]

  @@unique([tableId, userId])
  @@index([userId])
  @@map("table_participations")
}

model BuyIn {
  id              String   @id @default(cuid())
  participationId String
  amount          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  participation TableParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([participationId])
  @@map("buy_ins")
}

model CashOut {
  id              String   @id @default(cuid())
  participationId String   @unique
  amount          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  participation TableParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@map("cash_outs")
}

model Settlement {
  id            String           @id @default(cuid())
  tableId       String
  fromUserId    String?
  fromGuestName String?
  toUserId      String?
  toGuestName   String?
  toPixKey      String?
  amount        Decimal          @db.Decimal(12, 2)
  pixCopiaECola String?
  status        SettlementStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  confirmedAt   DateTime?

  table    Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  fromUser User? @relation("SettlementFromUser", fields: [fromUserId], references: [id])
  toUser   User? @relation("SettlementToUser", fields: [toUserId], references: [id])

  @@index([tableId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("settlements")
}

model ActionRequest {
  id              String              @id @default(cuid())
  tableId         String
  participationId String
  requestedById   String
  type            ActionType
  amount          Decimal?            @db.Decimal(12, 2)
  status          ActionRequestStatus @default(PENDING)
  requestedAt     DateTime            @default(now())
  resolvedAt      DateTime?

  table         Table              @relation(fields: [tableId], references: [id], onDelete: Cascade)
  participation TableParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  requestedBy   User               @relation("ActionRequestRequester", fields: [requestedById], references: [id])

  @@index([tableId])
  @@index([participationId])
  @@index([requestedById])
  @@map("action_requests")
}
